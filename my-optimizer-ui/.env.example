# Copy to .env for local development. .env is gitignored.
# These are build-time values: Vite inlines them, so every VITE_ variable is
# public in the shipped bundle. Never put a service-role key or any secret here.

# The FastAPI backend. Defaults to http://localhost:8000 when unset, which is
# why a production build MUST set this - in the hosting project's environment
# variables (Vercel: Settings -> Environment Variables), then redeploy.
VITE_API_URL=http://localhost:8000

# Supabase project URL and publishable ("anon") key.
# Dashboard -> Project Settings -> API.
# The anon key is safe to ship ONLY when row-level security is enabled on every
# table - see supabase/policies.sql.
VITE_SUPABASE_URL=https://yourproject.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
