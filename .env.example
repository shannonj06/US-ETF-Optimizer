# Copy to .env and fill in. .env is gitignored - never commit real values.

# ── Data ─────────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string for the ETF universe (database: etf_data).
MONGODB_URL=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/

# ── API ──────────────────────────────────────────────────────────────────────
# "development" or "production". Production hides internal error detail from
# API responses (it is still logged in full).
ENVIRONMENT=development

# Comma-separated origins allowed to call the API from a browser.
# Set this to your deployed client only in production.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Auth ─────────────────────────────────────────────────────────────────────
# Used to verify the access token the React client sends. Without these the API
# cannot identify anyone and meters every caller as a guest.
# Both come from the Supabase dashboard: Project Settings -> API.
SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_ANON_KEY=your-publishable-anon-key

# ── Access policy ────────────────────────────────────────────────────────────
# Set to false to require an account for every request (disables the guest
# preview entirely). Guest allowances live in backend/guest_policy.py.
ALLOW_GUEST_ACCESS=true

# Per-caller rate limit on the expensive endpoints.
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=3600

# True when the API sits behind a proxy that sets X-Forwarded-For (Railway,
# Render, Fly). Set to false if the API is exposed directly - otherwise a guest
# can reset their quota by spoofing the header.
TRUST_PROXY_HEADERS=true
